# Copy this file to .env. Do not commit the real file.
AUTOMATION_TIME_ZONE=Asia/Kolkata
AUTOMATION_TOKEN=replace-with-the-same-value-used-by-the-Scanimart-API
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=replace-with-a-strong-local-password
SCANIMART_API_URL=http://host.docker.internal:3000
SCANIMART_N8N_URL=http://n8n:5678
SCANIMART_ADMIN_RECIPIENT=919999999999
WHATSAPP_API_VERSION=v22.0
WHATSAPP_PHONE_NUMBER_ID=replace-with-meta-phone-number-id
WHATSAPP_ACCESS_TOKEN=replace-with-meta-access-token
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-chat
