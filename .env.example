# Firebase Console > Project settings > Service accounts > Generate new private key
FIREBASE_DATABASE_URL=https://YOUR_PROJECT_ID-default-rtdb.firebaseio.com
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
HOST=0.0.0.0
PUBLIC_HOST=192.168.1.9
PORT=3000
HTTPS_PORT=3443
SSL_KEY_PATH=./cert/server-key.pem
SSL_CERT_PATH=./cert/server-cert.pem


# Razorpay Dashboard > Settings > API Keys (leave empty to use cash-only mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions


# Google Auth Platform > APIs & Services > Credentials > OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# Redis (optional but recommended for production; falls back to in-memory cache without it)
REDIS_URL=


# Free automation notifications
AUTOMATION_TOKEN=replace-with-a-long-random-token
# Set this to your publicly reachable n8n production webhook in production.
N8N_CUSTOMER_EMAIL_WEBHOOK_URL=http://127.0.0.1:5678/webhook/customer-email-event
# Set this instead of N8N_CUSTOMER_EMAIL_WEBHOOK_URL when using Firebase Functions.
CUSTOMER_EMAIL_FUNCTION_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
AUTOMATION_TIME_ZONE=Asia/Kolkata
# Set this to the public ScaniMart URL in production.
PUBLIC_BASE_URL=http://localhost:3000
